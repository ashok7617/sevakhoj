# Copy to .env.local and adjust as needed.

# PostgreSQL + PostGIS connection string
DATABASE_URL="postgres://care:care@localhost:5432/india_care_setu"

# Admin area protection (HTTP Basic Auth on /admin).
# Required in production — /admin is denied (503) if ADMIN_PASSWORD is unset.
# In local dev, /admin is open unless you set these.
# ADMIN_USER="admin"
# ADMIN_PASSWORD=""

# AI provider for the Care Finder (grounded retrieval only).
# The app is provider-agnostic; set whichever you use.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Maps (client-side). Use Mapbox or Google Maps.
# NEXT_PUBLIC_MAPBOX_TOKEN=""
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# DigiLocker (server-side) — for /apply/up-bocw scheme-application pre-fill.
# Leave blank to run in SANDBOX MOCK mode (uses a fixed test identity, no real call).
# Onboard as a Requester at partners.digilocker.gov.in to get these.
# DIGILOCKER_BASE="https://digilocker.meripehchaan.gov.in"
# DIGILOCKER_CLIENT_ID=""
# DIGILOCKER_CLIENT_SECRET=""
# DIGILOCKER_REDIRECT_URI="https://sevakhoj.com/api/digilocker/callback"
# DIGILOCKER_SCOPE=""   # optional; set only if your partner config needs an explicit scope
