# Pipeline environment. Copy to pipeline/.env (or rely on the repo root
# .env.local, which is read automatically for DATABASE_URL).

# Postgres + PostGIS (same DB as the Next.js app).
DATABASE_URL="postgres://care:care@localhost:5432/india_care_setu"

# data.gov.in API key — register free at https://www.data.gov.in to obtain one.
# (data.gov.in publishes a demo key in its API docs for quick testing; it is
#  heavily rate-limited. Use your own key for real ingestion.)
DATA_GOV_IN_API_KEY=""

# Optional: set a dataset's real resource_id without editing resources.py.
# Find it on the dataset's page at data.gov.in.
# DGI_RESOURCE_OLD_AGE_HOMES=""
# DGI_RESOURCE_CHILD_CARE_INSTITUTIONS=""
# DGI_RESOURCE_DISABILITY_DDRC=""
